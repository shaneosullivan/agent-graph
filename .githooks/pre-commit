#!/usr/bin/env bash
# Lints the site's staged files with ESLint, fixing what it can, and formats
# them with Prettier before each commit, as `npm run format` would (the
# site's eslint.config.mjs, .prettierrc and .prettierignore), and stages the
# result. A lint error ESLint can't fix stops the commit. Git runs it once
# `core.hooksPath` is .githooks, which `npm install` in site/ sets (its
# `prepare` script).
#
# A file with changes that aren't staged is only checked, not fixed:
# staging it again would commit those changes too. If it needs fixing, the
# commit stops, and says so.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# The staged site files Prettier formats, as paths inside site/.
files=()
while IFS= read -r path; do
  files+=("${path#site/}")
done < <(git diff --cached --name-only --diff-filter=ACMR -- site |
  grep -E '\.(js|mjs|cjs|jsx|ts|mts|cts|tsx|json|css|md|ya?ml)$' || true)
[ ${#files[@]} -gt 0 ] || exit 0

prettier=site/node_modules/.bin/prettier
if [ ! -x "$prettier" ]; then
  echo "pre-commit: Prettier isn't installed, so the site's files weren't formatted (cd site && npm install). CI checks them." >&2
  exit 0
fi
prettier=node_modules/.bin/prettier
eslint=node_modules/.bin/eslint
if [ ! -x "site/$eslint" ]; then
  echo "pre-commit: ESLint isn't installed, so the site's files weren't linted (cd site && npm install). CI checks them." >&2
  eslint=
fi

# Git runs from the top, with paths under site/: in a linked worktree it
# hands the hook GIT_DIR, and with that set, git takes wherever it runs as
# the top of the work tree, so from site/ a path would be read as one at the
# top. ESLint and Prettier run from site/, so its .prettierignore applies
# (it's read from where Prettier runs).
whole=()
partial=()
for f in "${files[@]}"; do
  if git diff --quiet -- "site/$f"; then whole+=("$f"); else partial+=("$f"); fi
done

# The files ESLint lints (eslint.config.mjs), of those.
linted() {
  local f
  for f in "$@"; do
    case "$f" in *.ts | *.tsx) printf '%s\n' "$f" ;; esac
  done
}

if [ ${#whole[@]} -gt 0 ]; then
  if [ -n "$eslint" ]; then
    lint=()
    while IFS= read -r f; do lint+=("$f"); done < <(linted "${whole[@]}")
    # --no-warn-ignored: a staged file the config ignores isn't an error.
    if [ ${#lint[@]} -gt 0 ] && ! (cd site && "$eslint" --fix --no-warn-ignored -- "${lint[@]}"); then
      git add -- "${whole[@]/#/site/}"
      echo "pre-commit: fix the lint errors above, stage them, and commit again." >&2
      exit 1
    fi
  fi
  (cd site && "$prettier" --write --ignore-unknown --log-level warn -- "${whole[@]}")
  git add -- "${whole[@]/#/site/}"
fi

# What's staged of each, as it's what's committed: formatted, it's the same.
# (Empty lists are only expanded behind a check: bash 3, macOS's, calls
# them unset.)
unformatted=()
if [ ${#partial[@]} -gt 0 ]; then
  for f in "${partial[@]}"; do
    staged="$(git show ":site/$f")"
    if [ "$(printf '%s\n' "$staged" | (cd site && "$prettier" --stdin-filepath "$f"))" != "$staged" ]; then
      unformatted+=("site/$f")
    elif [ -n "$eslint" ] && [ -n "$(linted "$f")" ] &&
      ! printf '%s\n' "$staged" | (cd site && "$eslint" --no-warn-ignored --stdin --stdin-filename "$f") >&2; then
      unformatted+=("site/$f")
    fi
  done
fi
if [ ${#unformatted[@]} -gt 0 ]; then
  echo "pre-commit: these need formatting or lint fixes, and have changes that aren't staged, so they weren't fixed for you:" >&2
  printf '  %s\n' "${unformatted[@]}" >&2
  echo "Run \`npm run format\` in site/, stage what you want to commit, and commit again." >&2
  exit 1
fi
