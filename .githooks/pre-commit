#!/usr/bin/env bash
# Lints the site's staged files with ESLint, fixing what it can, and formats
# them with Prettier before each commit, as `npm run format` would (the
# site's eslint.config.mjs, .prettierrc and .prettierignore), and stages the
# result. A lint error ESLint can't fix stops the commit. Git runs it once
# `core.hooksPath` is .githooks, which `npm install` in site/ sets (its
# `prepare` script).
#
# First, what the site copies from the crate, which CI checks is up to
# date: the viewer (src/view/assets/ → site/public/viewer/ and
# site/lib/viewer-shell.ts), synced and staged when a commit changes it;
# and the WebAssembly (site/public/viewer/agent_graph.wasm), checked when a
# commit changes what it's built from, and rebuilt and staged if it's out
# of date.
#
# A file with changes that aren't staged is only checked, not fixed:
# staging it again would commit those changes too. If it needs fixing, the
# commit stops, and says so.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# The viewer's copies. (Generated, and in .prettierignore: nothing below
# formats them.)
copies=(site/public/viewer/app.js site/public/viewer/app.css site/public/viewer/d3.min.js site/lib/viewer-shell.ts)
if ! git diff --cached --quiet -- src/view/assets; then
  if ! git diff --quiet -- src/view/assets; then
    echo "pre-commit: src/view/assets has changes that aren't staged, so the site's copies of the viewer weren't synced. Stage them (or stash them), and commit again." >&2
    exit 1
  fi
  node site/scripts/sync-viewer.mjs >/dev/null
  git add -- "${copies[@]}"
fi

# The WebAssembly: what it's built from is the files its record lists, and
# the crates and build profile (Cargo.toml, Cargo.lock). Checking takes a
# fraction of a second; rebuilding, a few seconds more.
stamp=site/public/viewer/agent_graph.wasm.sources
if [ -f "$stamp" ]; then
  listed="$(node -e 'const fs = require("fs");
    for (const f of JSON.parse(fs.readFileSync(process.argv[1], "utf8")).files) console.log(f)' "$stamp")" || {
    echo "pre-commit: can't read $stamp, which says what the site's WebAssembly is built from." >&2
    exit 1
  }
  inputs=(Cargo.toml Cargo.lock wasm/Cargo.toml)
  while IFS= read -r f; do
    [ -n "$f" ] && inputs+=("$f")
  done <<<"$listed"
  # Cargo, where rustup puts it, if it isn't on PATH (as release.sh finds it).
  PATH="$HOME/.cargo/bin:$PATH"
  if ! command -v cargo >/dev/null 2>&1 && command -v rustup >/dev/null 2>&1; then
    PATH="$(dirname "$(rustup which cargo)"):$PATH"
  fi
  if git diff --cached --quiet -- "${inputs[@]}"; then
    : # Nothing it's built from is changing.
  elif ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: Rust isn't installed, so the site's WebAssembly wasn't checked. CI checks it." >&2
  elif ! node site/scripts/sync-viewer.mjs --check-wasm >/dev/null 2>&1; then
    # Built from the files as they are: only what's committed, if all of it's staged.
    if ! git diff --quiet -- "${inputs[@]}"; then
      echo "pre-commit: site/public/viewer/agent_graph.wasm is out of date, and what it's built from has changes that aren't staged, so it wasn't rebuilt. Stage them (or stash them), and commit again; or run \`npm run build-wasm\` in site/ and stage it." >&2
      exit 1
    fi
    echo "pre-commit: the site's WebAssembly is out of date: rebuilding it (npm run build-wasm)…" >&2
    if ! (cd site && npm run -s build-wasm) >&2; then
      echo "pre-commit: couldn't rebuild it. Fix that, run \`npm run build-wasm\` in site/, stage it, and commit again." >&2
      exit 1
    fi
    git add -- site/public/viewer/agent_graph.wasm "$stamp" "${copies[@]}"
  fi
fi

# The staged site files Prettier formats, as paths inside site/.
files=()
while IFS= read -r path; do
  files+=("${path#site/}")
done < <(git diff --cached --name-only --diff-filter=ACMR -- site |
  grep -E '\.(js|mjs|cjs|jsx|ts|mts|cts|tsx|json|css|md|ya?ml)$' || true)
[ ${#files[@]} -gt 0 ] || exit 0

prettier=site/node_modules/.bin/prettier
if [ ! -x "$prettier" ]; then
  echo "pre-commit: Prettier isn't installed, so the site's files weren't formatted (cd site && npm install). CI checks them." >&2
  exit 0
fi
prettier=node_modules/.bin/prettier
eslint=node_modules/.bin/eslint
if [ ! -x "site/$eslint" ]; then
  echo "pre-commit: ESLint isn't installed, so the site's files weren't linted (cd site && npm install). CI checks them." >&2
  eslint=
fi

# Git runs from the top, with paths under site/: in a linked worktree it
# hands the hook GIT_DIR, and with that set, git takes wherever it runs as
# the top of the work tree, so from site/ a path would be read as one at the
# top. ESLint and Prettier run from site/, so its .prettierignore applies
# (it's read from where Prettier runs).
whole=()
partial=()
for f in "${files[@]}"; do
  if git diff --quiet -- "site/$f"; then whole+=("$f"); else partial+=("$f"); fi
done

# The files ESLint lints (eslint.config.mjs), of those.
linted() {
  local f
  for f in "$@"; do
    case "$f" in *.ts | *.tsx) printf '%s\n' "$f" ;; esac
  done
}

if [ ${#whole[@]} -gt 0 ]; then
  if [ -n "$eslint" ]; then
    lint=()
    while IFS= read -r f; do lint+=("$f"); done < <(linted "${whole[@]}")
    # --no-warn-ignored: a staged file the config ignores isn't an error.
    if [ ${#lint[@]} -gt 0 ] && ! (cd site && "$eslint" --fix --no-warn-ignored -- "${lint[@]}"); then
      git add -- "${whole[@]/#/site/}"
      echo "pre-commit: fix the lint errors above, stage them, and commit again." >&2
      exit 1
    fi
  fi
  (cd site && "$prettier" --write --ignore-unknown --log-level warn -- "${whole[@]}")
  git add -- "${whole[@]/#/site/}"
fi

# What's staged of each, as it's what's committed: formatted, it's the same.
# (Empty lists are only expanded behind a check: bash 3, macOS's, calls
# them unset.)
unformatted=()
if [ ${#partial[@]} -gt 0 ]; then
  for f in "${partial[@]}"; do
    staged="$(git show ":site/$f")"
    if [ "$(printf '%s\n' "$staged" | (cd site && "$prettier" --stdin-filepath "$f"))" != "$staged" ]; then
      unformatted+=("site/$f")
    elif [ -n "$eslint" ] && [ -n "$(linted "$f")" ] &&
      ! printf '%s\n' "$staged" | (cd site && "$eslint" --no-warn-ignored --stdin --stdin-filename "$f") >&2; then
      unformatted+=("site/$f")
    fi
  done
fi
if [ ${#unformatted[@]} -gt 0 ]; then
  echo "pre-commit: these need formatting or lint fixes, and have changes that aren't staged, so they weren't fixed for you:" >&2
  printf '  %s\n' "${unformatted[@]}" >&2
  echo "Run \`npm run format\` in site/, stage what you want to commit, and commit again." >&2
  exit 1
fi
