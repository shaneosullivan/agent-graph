/target
.DS_Store
# Local tooling, except the project's Claude Code settings: the hooks that
# share this repository's Claude Code cloud sessions (install claude-code --cloud)
/.claude/*
!/.claude/settings.json
/.last_modified_timestamp

# Secrets: the Firebase service account key
/config/
# Your own settings for scripts (scripts/notarize-mac.sh: your Apple account)
/.env.local

# What a viewer or share run on the example logs records beside them
/examples/logs/view-*.json
/examples/logs/shares/

# Launch video assets, not committed for now
/media/
