# Copy to .env.local for development.

# Signs write tokens and viewer cookies. Long and random in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_GRAPH_SECRET=

# Encrypts logs before they're stored in Firestore: 32 random bytes,
# base64url. Generate it the same way. Keep it safe and never change it:
# without it, stored logs can't be read.
AGENT_GRAPH_ENCRYPTION_KEY=

# The public address, used in the links the API hands out.
NEXT_PUBLIC_SITE_URL=https://agentgraph.chofter.com

# Vercel Cron sends it to /api/cron/cleanup (the daily deletion of logs with
# no event for a week), which refuses to run without it. Long and random.
CRON_SECRET=

# The accounts that can see /admin (how the site's used): their emails,
# comma-separated. Only a verified email counts (Google's are).
ADMIN_EMAILS=

# "true" to count nothing: no page views, downloads, watch sessions or
# sign-ups (lib/analytics.ts). "false" unless it's set.
ANALYTICS_DISABLED=false

# Production: a Firebase service account's JSON key, on one line.
FIREBASE_SERVICE_ACCOUNT=

# Accounts (Firebase Authentication, with Email/Password and Google sign-in
# enabled). The web app's settings, from the Firebase console (Project
# settings, Your apps). They're public: every login page has them, and the
# browser signs in with Firebase directly. Add the site's domain to
# Authentication's authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Subscriptions, with Stripe (lib/billing.ts; setting it up: STRIPE.md).
# With STRIPE_MODE and every setting it needs set, an account can share
# live for FREE_TRIAL_DAYS days, then has to subscribe, monthly or yearly.
# With any of them unset, sharing live is free, and every account is active.
#
# Which of Stripe's modes to use: test or production. Each has its own keys
# and prices, below; only the chosen mode's need to be set.
STRIPE_MODE=
# Production (Stripe's live mode): the secret key (sk_live_…) or a
# restricted key (rk_live_…); the webhook endpoint's signing secret
# (whsec_…), for https://<the site>/api/stripe/webhook; and the monthly and
# yearly recurring prices (price_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Test mode: the same, from a Stripe sandbox (sk_test_… or rk_test_…);
# its webhook is https://<the site>/api/stripe/webhook-test.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_MONTHLY=
STRIPE_TEST_PRICE_YEARLY=
# Each plan's cost, as the account page and /faq show it, in either mode.
# (In this file, a $ must be written \$: Next.js reads $5 as a variable,
# and leaves nothing. In Vercel's settings, write it as it is.)
STRIPE_MONTHLY_LABEL=\$5 a month
STRIPE_YEARLY_LABEL=\$50 a year
# Days an account can share live before it has to subscribe. Default 7.
FREE_TRIAL_DAYS=7

# Development: use the emulators instead (npm run emulators), for Firestore
# and accounts. (The emulator takes any API key.)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-agent-graph
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-agent-graph
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
