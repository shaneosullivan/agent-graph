# Your own settings for this repository's scripts. Copy this file to
# .env.local (which git ignores) and fill it in. A variable set in the
# environment wins over one there.

# scripts/notarize-mac.sh (--help says more)
# The Apple Developer team to sign as. Optional with one Developer ID
# certificate in the Keychain: its team.
APPLE_TEAM_ID=
# The developer account's Apple ID: only to store the notarization
# credentials, the first time (with NOTARY_PASSWORD, an app-specific
# password, given on the command line rather than kept here).
APPLE_ID=
# The Keychain profile holding the notarization credentials. Unset, it's
# AgentGraphNotary.
NOTARY_PROFILE=

# scripts/release.sh (--help says more)
# The bucket release archives go in, as gs://<bucket>: a Firebase Storage
# bucket, whose download tokens make each archive's URL public.
RELEASE_BUCKET=
# The Homebrew tap's GitHub repository, as <owner>/homebrew-<name>.
HOMEBREW_TAP=
# The gcloud account that can write to the bucket (gcloud's active one if
# unset).
GCLOUD_ACCOUNT=
