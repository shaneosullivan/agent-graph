# Copy this file to .env, then paste your key below.
#
# Make a key on your account page, under "API keys":
#   https://agentgraph.chofter.com/account#api-keys
#
# A secret key (ag_sk_live_…) reads every graph your account shares live; a
# restricted one (ag_rk_live_…) only the shares you chose for it. Either works
# here. It's read only by this app's server: it's never sent to the browser.
AGENT_GRAPH_KEY=

# Where the API is. Leave it as it is, unless you run the site yourself.
AGENT_GRAPH_API_URL=https://agentgraph.chofter.com/api/v1
